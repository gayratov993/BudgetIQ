# PostgreSQL ulanish satri (Neon, Supabase yoki lokal Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/budgetiq?schema=public"

# Ommaviy manzil (SEO: canonical, sitemap, robots, OG). Prodda domeningizni yozing.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth (openssl rand -base64 32 yoki node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# AI provayder — bittasi yetarli. Kalit bo'lmasa ilova fallback rejimda ishlaydi.
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""
# Gemini modeli (default: gemini-3.5-flash-lite)
AI_MODEL=""

# Google OAuth (ixtiyoriy)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
